syntax on
filetype plugin indent on
filetype plugin on

set nocompatible
set nowrap
set termguicolors
set clipboard=unnamed
set fillchars=vert:\ 
set encoding=utf-8
set grepprg=grep\ -nH\ $*
set hidden
set list
set listchars=tab:▸\ ,trail:·
set mouse=a
set numberwidth=6
set path+=**
set ruler
set t_Co=256
set wildmenu
set splitbelow
set splitright
set textwidth=80
set cmdheight=2 " for details see :help netrw-p10<CR>

" Airline setup
if exists(':AirlineRefresh')
  let g:airline_powerline_fonts = 1
  let g:airline_left_sep = '»'
  let g:airline_right_sep = '«'
  let g:airline_symbols.crypt = '🔒'
  let g:airline_symbols.linenr = '␤'
  let g:airline_symbols.branch = '⎇'
  let g:airline_symbols.paste = 'ρ'
  let g:airline_symbols.notexists = '∄'
  let g:airline_symbols.whitespace = '☰'
  let g:airline#extensions#tabline#formatter = 'unique_tail'
endif

" Justify text
" Vim includes a macro that justifies the text, if it is present in your
" system, include it.
runtime! macros/justify.vim

hi Normal guibg=NONE ctermbg=NONE

" Ignore the files generated by the compilers, interpreters and VCSs,
" see |settings-wildignore|
let s:hidden_files = [
      \ '__pycache__/**',
      \ '.*\.pyc',
      \ '.*\.o',
      \ '.*\.swp',
      \ '.*~',
      \ '.git',
      \ '.DS_Store',
      \ '**/node_modules/**',
      \ 'tags'
      \ ]
let &wildignore = join(s:hidden_files, ',')

" Explorer setup, see |settings-netrw|
call settings#netrw()

" - Buffer navigation, see |settings-normal-mappings|
nnoremap <Up> :ls<CR>:b
nnoremap <Left> :bprevious<CR>
nnoremap <Right> :bnext<CR>
nnoremap <Down> <Nop>

" Insert mode key mappings, see |settings-insert-mappings|
inoremap {<CR> {<CR>}<Esc>O
inoremap [<CR> [<CR>]<Esc>O
inoremap (<CR> (<CR>)<Esc>O

inoremap '' ''<Esc>i
inoremap "" ""<Esc>i
inoremap (( ()<Esc>i
inoremap [[ []<Esc>i
inoremap {{ {}<Esc>i
inoremap <Tab><Tab> <Esc>Ea

" Keyboard layout mappings, see |settings-keyboard|
if settings#kb_should_load()
  let g:did_kb = 1
  call settings#kb_init()

  command! -nargs=0 KbEs call settings#kb_es()
  command! -nargs=0 KbLatam call settings#kb_latam()
endif
